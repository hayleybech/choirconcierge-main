			"component": "Central/Dash/Show",
			"browser": "chromium",
			"assert_text": "Central Dashboard"
		},
		{
			"id": "central-changelog",
			"module": "central",
			"page_type": "index",
			"state": "normal",
			"route": "central.changelog",
			"parameters": {},
			"persona": "authenticated-user",
			"component": "Central/Changelog",
			"browser": "chromium",
			"assert_text": "Changelog"
		},
		{
			"id": "central-tenant-create",
			"module": "central",
			"page_type": "create",
