{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "barryvdh/laravel-ide-helper": "^2.12",
        "doctrine/dbal": "^3.3",
        "fakerphp/faker": "^1.9.1",
        "garygreen/pretty-routes": "^1.0",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^1.0",
        "jfcherng/php-diff": "^6.16",
        "laravel/framework": "^10.0",
        "laravel/nightwatch": "^1.15",
        "laravel/slack-notification-channel": "^3.6",
        "laravel/spark-paddle": "4.1.1",
        "laravel/telescope": "^4.7",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "~3.1",
        "mailgun/mailgun-php": "^4.3",
        "sentry/sentry-laravel": "^3.0",
        "spatie/calendar-links": "^1.7",
        "spatie/flysystem-dropbox": "^2.0",
        "spatie/icalendar-generator": "^2.3",
        "spatie/laravel-backup": "^8.0",
        "spatie/laravel-medialibrary": "^10.1",
        "spatie/laravel-query-builder": "^5.0",
        "spatie/laravel-robots-middleware": "^1.3",
        "stancl/tenancy": "^3.1",
        "symfony/http-client": "^6.0",
        "symfony/mailgun-mailer": "^6.0",
        "tightenco/ziggy": "^1.4",
        "webklex/laravel-imap": "^6.0"
    },
    "type": "project",
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "beyondcode/laravel-query-detector": "^1.6",
        "jasonmccreary/laravel-test-assertions": "^2.1",
        "laravel/sail": "^1.13",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "spatie/laravel-ignition": "^2.0",
        "wnx/laravel-stats": "^2.8"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan telescope:publish",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://spark.laravel.com"
        }
    ]
}
