{
    "name": "choirconcierge/spark-paddle-classic",
    "version": "4.1.1",
    "description": "Laravel Spark provides scaffolding for Laravel SaaS applications.",
    "keywords": ["laravel", "paddle", "billing", "scaffolding", "saas"],
    "license": "MIT",
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-bcmath": "*",
        "ext-json": "*",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0",
        "inertiajs/inertia-laravel": "^0.5.1|^0.6.4|^1.0",
        "choirconcierge/cashier-paddle-classic": "^1.12"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.5|^10.4"
    },
    "autoload": {
        "psr-4": {
            "ChoirConcierge\\LegacySpark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChoirConcierge\\LegacySpark\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "laravel": {
            "providers": [
                "ChoirConcierge\\LegacySpark\\SparkServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "csfix": [
            "php-cs-fixer fix src database routes tests --config=.php_cs"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
